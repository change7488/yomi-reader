{
  "name": "libra-reader-desktop",
  "version": "0.2.1",
  "type": "module",
  "description": "Libra Reader Windows desktop ebook library",
  "main": "electron/main.cjs",
  "author": "Libra Reader",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test ui-prototype/reader/*.test.mjs ui-prototype/library-model.test.mjs electron/*.test.cjs",
    "test:ui": "electron electron/ui-smoke.cjs",
    "test:reader": "node --test ui-prototype/reader/*.test.mjs",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "app.libra.reader",
    "productName": "Libra Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "ui-prototype/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/libra.ico",
      "artifactName": "Libra-Reader-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
